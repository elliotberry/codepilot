{
    "name": "coderobot",
    "author": "Steven Ickman + elliot",
    "description": "Codepilot is fairtly simple way to load a repo into a local embeddings db and talk to it via a gpt model.",
    "version": "0.2.2",
    "license": "The Unlicense",
    "type": "module",
    "keywords": [
        "gpt",
        "coding",
        "embeddings",
        "node"
    ],
    "bin": {
        "coderobot": "./src/codepilot-cli.js"
    },
    "dependencies": {
        "@topcli/spinner": "^2.1.2",
        "alphawave": "0.22.0",
        "dotenv": "^16.5.0",
        "elliotisms": "^0.0.51",
        "gpt-tokenizer": "^2.9.0",
        "is-binary": "^0.1.0",
        "junk": "^4.0.1",
        "nanoid": "^5.1.5",
        "promptrix": "0.6.0",
        "xxhash-addon": "^2.0.3",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@stylistic/eslint-plugin-js": "^4.2.0",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-n": "^17.17.0",
        "eslint-plugin-no-secrets": "^2.2.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-perfectionist": "^4.12.3",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "prettier": "^3.5.3",
        "release-it": "^19.0.2"
    },
    "prettier": {
        "arrowParens": "always",
        "bracketSameLine": true,
        "bracketSpacing": true,
        "semi": false,
        "experimentalTernaries": true,
        "singleQuote": false,
        "jsxSingleQuote": false,
        "quoteProps": "as-needed",
        "trailingComma": "none",
        "singleAttributePerLine": false,
        "htmlWhitespaceSensitivity": "css",
        "vueIndentScriptAndStyle": false,
        "proseWrap": "preserve",
        "insertPragma": false,
        "printWidth": 80,
        "requirePragma": false,
        "tabWidth": 2,
        "useTabs": false,
        "embeddedLanguageFormatting": "auto"
    }
}
